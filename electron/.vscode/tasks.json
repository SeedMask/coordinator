{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "path": "${workspaceFolder}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "path": "${workspaceFolder}",
      "problemMatcher": []
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "${workspaceFolder}",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "npm: release",
      "type": "npm",
      "script": "release",
      "path": "${workspaceFolder}",
      "problemMatcher": []
    }
  ]
}
